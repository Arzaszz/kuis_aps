Enum status_pemesanan {
  CONFIRMED
  BOOKED
  WAITING_FOR_PAYMENT
  CANCELLED
}

Table Bandara {
  kode varchar(3) [pk]
  nama varchar(120) [not null]
  kota varchar(100) [not null]
}

Table Maskapai {
  kode varchar(10) [pk]
  nama varchar(120) [not null]
}

Table Pesawat {
  kode varchar(30) [pk]
  model varchar(100) [not null]
  kapasitas int [not null]
}

Table Kursi {
  id int [pk, increment]
  pesawat_kode varchar(30) [not null]
  nomor varchar(8) [not null]
  kelas varchar(30) [not null]

  indexes {
    (pesawat_kode, nomor) [unique]
  }
}

Table Penerbangan {
  nomor_penerbangan varchar(20) [pk]
  maskapai_kode varchar(10) [not null]
  pesawat_kode varchar(30)
  bandara_asal varchar(3) [not null]
  bandara_tujuan varchar(3) [not null]
  waktu_berangkat datetime [not null]
  waktu_tiba datetime [not null]
  harga decimal(14,2) [not null]
  kursi_tersedia int [not null]
}

Table Member {
  id varchar(30) [pk]
  nama varchar(120)
  email varchar(254)
  telepon varchar(30)
  nomor_identitas varchar(50)
}

Table Pemesanan {
  kode_booking varchar(20) [pk]
  member_id varchar(30)
  nama_pemesan varchar(120) [not null]
  email varchar(254) [not null]
  waktu_pemesanan datetime [not null]
  status status_pemesanan [not null]
}

Table Penumpang {
  id int [pk, increment]
  nama varchar(120) [not null]
  email varchar(254) [not null]
  telepon varchar(30)
  nomor_identitas varchar(50) [not null]
}

Table Tiket {
  nomor_tiket varchar(20) [pk]
  kode_booking varchar(20) [not null]
  nomor_penerbangan varchar(20) [not null]
  penumpang_id int [not null]
  waktu_terbit datetime [not null]
  tervalidasi boolean [not null, default: false]
}

Table Pembayaran {
  id varchar(30) [pk]
  kode_booking varchar(20) [not null]
  jumlah decimal(14,2) [not null]
  waktu_pembayaran datetime
  status varchar(30) [not null]
}

Table Pegawai {
  id varchar(30) [pk]
  nama varchar(120) [not null]
  jatah_cuti_tahunan int [not null]
}

Table Cuti {
  id varchar(30) [pk]
  pegawai_id varchar(30) [not null]
  tanggal_mulai date [not null]
  tanggal_selesai date [not null]
  status varchar(30) [not null]
}

Ref: Kursi.pesawat_kode > Pesawat.kode
Ref: Penerbangan.maskapai_kode > Maskapai.kode
Ref: Penerbangan.pesawat_kode > Pesawat.kode
Ref: Penerbangan.bandara_asal > Bandara.kode
Ref: Penerbangan.bandara_tujuan > Bandara.kode
Ref: Pemesanan.member_id > Member.id
Ref: Tiket.kode_booking > Pemesanan.kode_booking
Ref: Tiket.nomor_penerbangan > Penerbangan.nomor_penerbangan
Ref: Tiket.penumpang_id > Penumpang.id
Ref: Pembayaran.kode_booking > Pemesanan.kode_booking
Ref: Cuti.pegawai_id > Pegawai.id
